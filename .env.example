# ============================================================
#  CẤU HÌNH HỆ THỐNG TỰ ĐỘNG ĐĂNG BÀI BÓNG ĐÁ
#  File này KHÔNG được commit lên Git
#  Sao chép từ .env.example và điền thông tin thật vào
# ============================================================

# --- Facebook ---
# Danh sách trang đăng bài (ngăn cách bằng dấu phẩy)
# VD: FB_PAGES=myfanpage,another.page,123456789
FB_PAGES=THAY_SLUG_TRANG_CUA_BAN
FB_ACCESS_TOKEN=THAY_ACCESS_TOKEN_CUA_BAN

# --- Free AI (ưu tiên trước để không tốn chi phí) ---
FREE_AI_ONLY=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
HF_TOKEN=THAY_HF_TOKEN_CUA_BAN
HF_MODEL=deepseek-ai/DeepSeek-R1:fastest

# --- Grok AI (xAI) - AI chính để viết bài ---
GROK_API_KEY=THAY_GROK_KEY_CUA_BAN
GROK_MODEL=grok-3-mini-fast

# --- ChatGPT / OpenAI - chat trong app + fallback viết bài ---
OPENAI_API_KEY=THAY_OPENAI_KEY_CUA_BAN
OPENAI_MODEL=chat-latest

# --- Gemini AI - fallback + tạo ảnh ---
GEMINI_API_KEY=THAY_GEMINI_KEY_CUA_BAN
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Chống trùng bản tin ---
AVOID_RECENT_DUPLICATES=true
ARTICLE_HISTORY_DAYS=14
MAX_TOTAL_ARTICLES=8
